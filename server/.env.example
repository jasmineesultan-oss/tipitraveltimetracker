DATABASE_URL="postgresql://tipi:tipi_dev_password@localhost:5432/tipi_db?schema=public"
# DIRECT_URL should point directly at Postgres (bypassing any connection pooler like
# Neon's or PgBouncer) since `prisma migrate` needs a non-pooled connection.
DIRECT_URL="postgresql://tipi:tipi_dev_password@localhost:5432/tipi_db?schema=public"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="8h"
JWT_REMEMBER_EXPIRES_IN="30d"
PORT=4000
CLIENT_URL="http://localhost:5173"
# Required for leave request attachment uploads (Vercel Blob)
BLOB_READ_WRITE_TOKEN=""
